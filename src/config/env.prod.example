# Production Environment Variables
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com
NODE_ENV=production
DATABASE_URL=postgresql://school_user:production_password@postgres:5432/school_db
REDIS_URL=redis://:production_password@redis:6379
NEXTAUTH_SECRET=production-secret-key
NEXTAUTH_URL=https://your-domain.com

# Multi-Tenant Custom Domain Configuration
# Platform domain untuk custom domain feature
NEXT_PUBLIC_PLATFORM_DOMAIN=your-platform.com
# CNAME target untuk custom domain
NEXT_PUBLIC_CNAME_TARGET=cname.your-platform.com
# A Record target untuk custom domain (IP address)
NEXT_PUBLIC_A_RECORD_TARGET=76.76.21.21
