{
  "name": "school-website-builder",
  "version": "1.0.0-beta",
  "description": "A modern, open-source platform for building beautiful school websites with integrated academic management features",
  "keywords": [
    "school",
    "education",
    "website",
    "nextjs",
    "typescript",
    "tailwindcss",
    "academic",
    "student-management",
    "opensource"
  ],
  "author": "PT Koneksi Jaringan Indonesia",
  "license": "MIT",
  "homepage": "https://schoolwebsitebuilder.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/koneksi-jaringan/school-website-builder.git"
  },
  "bugs": {
    "url": "https://github.com/koneksi-jaringan/school-website-builder/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/school-website-builder"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=7.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "cross-env ANALYZE=true next build",
    "prepare": "simple-git-hooks",
    "postinstall": "prisma generate",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "node scripts/seed-database.js",
    "db:seed:admin": "node scripts/seed-admin.js",
    "db:seed:spmb": "node scripts/seed-spmb.js",
    "db:seed:contact": "node scripts/seed-contact.js",
    "db:seed:all": "node scripts/seed-database.js && node scripts/seed-admin.js && node scripts/seed-spmb.js && node scripts/seed-contact.js",
    "db:seed:smpn1srandakan": "node scripts/seed-smpn1-srandakan.js",
    "db:reset": "npx prisma db push --force-reset && npm run db:seed:all"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/adapter-libsql": "^7.4.0",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-aspect-ratio": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-collapsible": "latest",
    "@radix-ui/react-context-menu": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-hover-card": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-menubar": "latest",
    "@radix-ui/react-navigation-menu": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-radio-group": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slider": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-toggle": "latest",
    "@radix-ui/react-toggle-group": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@vercel/analytics": "1.3.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "latest",
    "date-fns": "4.1.0",
    "embla-carousel-react": "latest",
    "geist": "^1.3.1",
    "input-otp": "latest",
    "jose": "^6.1.2",
    "lucide-react": "^0.454.0",
    "next-themes": "latest",
    "react-day-picker": "latest",
    "react-hook-form": "latest",
    "react-resizable-panels": "latest",
    "recharts": "^3.2.1",
    "sonner": "latest",
    "sqlite3": "^5.1.7",
    "swr": "latest",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "latest"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@next/eslint-plugin-next": "^16.0.1",
    "@playwright/test": "^1.56.0",
    "@prisma/client": "^7.4.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.2",
    "baseline-browser-mapping": "^2.9.19",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-react": "^7.37.5",
    "framer-motion": "^12.23.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "next": "16.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^7.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8",
    "zod": "3.25.67"
  },
  "pre-commit": "pnpm lint && pnpm test",
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
