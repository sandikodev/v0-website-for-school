# ============================================
# AkseSekolah.id - Environment Variables
# ============================================
# Copy this file to .env for production
# Copy this file to .env.local for local development

# ============================================
# CORE SETTINGS
# ============================================

# Node Environment (development | production)
NODE_ENV=production

# Application Port
PORT=3000

# ============================================
# DATABASE
# ============================================

# Production: Turso (LibSQL) - Get from https://turso.tech
DATABASE_URL="libsql://your-database.turso.io?authToken=your-auth-token"

# Development: Local SQLite
# DATABASE_URL="file:./prisma/dev.db"

# ============================================
# AUTHENTICATION
# ============================================

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-here-generate-with-openssl-rand-base64-32"

# ============================================
# PLATFORM CONFIGURATION
# ============================================

# Platform Domain (without protocol)
NEXT_PUBLIC_PLATFORM_DOMAIN="aksesekolah.id"

# Dashboard URL (full URL with protocol)
NEXT_PUBLIC_DASHBOARD_URL="https://dashboard.aksesekolah.id"

# NextAuth URL (full URL with protocol)
NEXTAUTH_URL="https://aksesekolah.id"

# ============================================
# CUSTOM DOMAINS (Optional)
# ============================================

# DNS Configuration for custom domains
NEXT_PUBLIC_CNAME_TARGET="cname.aksesekolah.id"
NEXT_PUBLIC_A_RECORD_TARGET="76.76.21.21"

# ============================================
# EMAIL (Optional)
# ============================================

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@aksesekolah.id"

# ============================================
# STORAGE (Optional)
# ============================================

# Storage Type: local | s3 | cloudinary
STORAGE_TYPE="local"

# S3 Configuration (if using S3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ============================================
# ANALYTICS (Optional)
# ============================================

NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_HOTJAR_ID=""

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_REGISTRATION="true"
ENABLE_TENANT_CREATION="true"
ENABLE_CUSTOM_DOMAINS="true"

