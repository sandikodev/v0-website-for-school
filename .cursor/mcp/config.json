{
  "providers": [
    {
      "id": "fs",
      "enabled": true
    },
    {
      "id": "git",
      "enabled": true
    },
    {
      "id": "search",
      "enabled": true
    },
    {
      "id": "eslint",
      "enabled": true,
      "options": {
        "configPath": "./eslint.config.mts",
        "fix": true
      }
    },
    {
      "id": "typescript",
      "enabled": true,
      "options": {
        "project": "./tsconfig.json"
      }
    },
    {
      "id": "shell",
      "enabled": true,
      "options": {
        "allow": ["pnpm", "next", "eslint", "prisma"]
      }
    },
    {
      "id": "config",
      "enabled": true
    },
    {
      "id": "cursor-context",
      "enabled": true
    },
    {
      "id": "prisma",
      "enabled": true,
      "options": { "schema": "prisma/schema.prisma" }
    }
  ],
  "commands": {
    "lint:fix": "pnpm exec eslint . --ext ts,tsx,js,jsx --fix --cache",
    "typecheck": "pnpm exec tsc --noEmit",
    "analyze": "next build --analyze"
  }
}
