{
  "mcpServers": {
    "deepseek": {
      "command": "npx",
      "args": [
        "-y",
        "deepseek-mcp-server"
      ],
      "env": {
        "DEEPSEEK_API_KEY": "sk-6fdf8870d0ce47f4b7c144f35f2d58d9"
      }
    },
    "deepseek-thinker": {
      "command": "npx",
      "args": [
        "-y",
        "deepseek-thinker-mcp"
      ],
      "env": {
        "USE_OLLAMA": "true"
      }
    },
    "llm-ollama-llama3": {
      "url": "http://127.0.0.1:8080",
      "headers": {
        "Content-Type": "application/json"
      },
      "type": "http",
