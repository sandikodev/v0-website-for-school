        "streaming": true,
        "batching": false
      },
      "serverInfo": {
        "name": "mcp-llm",
        "version": "0.2.0"
      }
    },
    "ollama-mcp": {
      "url": "http://127.0.0.1:3456",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "ollama": {
      "command": "npx",
      "args": ["-y", "ollama-mcp"],
      "env": {
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "OLLAMA_API_KEY": "32608995c184493eaa080fd7924c8e18.wwm6jTBu07UTY2VMq1TkRZlk"
      }
    }
  }
