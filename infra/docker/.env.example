# ============================================
# Docker Development Environment Variables
# ============================================
# Copy this file to docker/.env for custom port configuration

# ============================================
# PORT CONFIGURATION
# ============================================
# Use non-standard ports to avoid conflicts with existing services

# Application port
PORT=3000

# PostgreSQL port (external)
# Default: 5433 (to avoid conflict with system PostgreSQL on 5432)
POSTGRES_PORT=5433

# Redis port (external)
# Default: 6380 (to avoid conflict with system Redis on 6379)
REDIS_PORT=6380

# PgAdmin port (external)
# Default: 8081 (to avoid conflict with other services on 8080)
PGADMIN_PORT=8081

# ============================================
# DATABASE CREDENTIALS
# ============================================
# These are for development only - change in production!

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aksesekolah_dev

# ============================================
# PGADMIN CREDENTIALS
# ============================================

# Note: Use .com domain (not .local) to avoid validation errors
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=admin

# ============================================
# NOTES
# ============================================
# 
# Internal vs External Ports:
# - External: Port on your host machine (configurable)
# - Internal: Port inside Docker container (fixed)
#
# Example:
# POSTGRES_PORT=5433 means:
# - Access from host: localhost:5433
# - Access from container: aksesekolah-db-dev:5432
#
# Why non-standard ports?
# - Avoid conflicts with existing PostgreSQL (5432)
# - Avoid conflicts with existing Redis (6379)
# - Avoid conflicts with other services (8080)
#
# To use standard ports (if no conflicts):
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# PGADMIN_PORT=8080

