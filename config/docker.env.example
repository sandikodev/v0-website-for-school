# docker.env.example
# Copy to .env and fill in your values

# Domain Configuration
DOMAIN=your-school-domain.com
EMAIL=admin@your-school-domain.com

# Database
DATABASE_URL=postgresql://username:password@db-host:5432/school_db

# Authentication
NEXTAUTH_SECRET=your-super-secret-key-here
NEXTAUTH_URL=https://your-school-domain.com

# Multi-Tenant Custom Domain Configuration
# Platform domain untuk custom domain feature (contoh: your-platform.com)
# Domain utama platform yang akan menerima custom domain requests
NEXT_PUBLIC_PLATFORM_DOMAIN=your-platform.com

# CNAME target untuk custom domain (default: cname.{NEXT_PUBLIC_PLATFORM_DOMAIN})
# IP atau hostname yang akan diarahkan oleh CNAME record dari custom domain
NEXT_PUBLIC_CNAME_TARGET=cname.your-platform.com

# A Record target untuk custom domain (IP address)
# IP address server yang akan menerima traffic dari custom domain
NEXT_PUBLIC_A_RECORD_TARGET=76.76.21.21

# SSL Certificate Configuration (optional)
# Email untuk Let's Encrypt certificate provisioning
SSL_EMAIL=admin@your-platform.com

# SSL Provider: letsencrypt, cloudflare, manual
SSL_PROVIDER=letsencrypt

# Optional: External Services
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
GOOGLE_MAPS_API_KEY=your-google-maps-key
